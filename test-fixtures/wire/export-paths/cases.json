{
  "about": "Which vault paths an export includes (export design EX16): exactly the paths the Obsidian plugin would write to disk. Read by apps/plugin's classifyPath test (a path is exportable iff it is not 'refused') and by apps/vault's export::pure::exportable test, so the two rules cannot drift apart.",
  "cases": [
    { "path": "Daily/2026-09-22.md", "exportable": true, "why": "a note" },
    { "path": "Board.canvas", "exportable": true, "why": "a canvas" },
    { "path": "Tasks.base", "exportable": true, "why": "a base" },
    { "path": "notes.txt", "exportable": true, "why": "plain text" },
    { "path": "attachments/diagram.png", "exportable": true, "why": "an attachment" },
    { "path": "papers/paper.PDF", "exportable": true, "why": "an attachment, extension case ignored" },
    { "path": "Café/Crème brûlée.md", "exportable": true, "why": "non-ASCII names are fine" },
    { "path": "Conflict (2026-09-22 1430).md", "exportable": true, "why": "a conflict copy is a user file" },
    { "path": ".obsidian/app.json", "exportable": false, "why": "Obsidian's config directory" },
    { "path": ".Obsidian/plugins/x/main.js", "exportable": false, "why": "the config directory, case-insensitively" },
    { "path": ".obsidian-mobile/plugins/x/data.json", "exportable": false, "why": "another device's config directory: every top-level dot-folder" },
    { "path": ".trash/old note.md", "exportable": false, "why": "Obsidian's own trash, a top-level dot-folder" },
    { "path": ".hidden.md", "exportable": false, "why": "a top-level dot-prefixed note, which Obsidian hides" },
    { "path": "notes/.hidden/x.md", "exportable": true, "why": "a dot-folder below the top level is not a config directory" },
    { "path": "scripts/run.js", "exportable": false, "why": "code: an export must never deliver it" },
    { "path": "tool.EXE", "exportable": false, "why": "code, extension case ignored" },
    { "path": "Makefile", "exportable": false, "why": "no extension" },
    { "path": ".gitignore", "exportable": false, "why": "no extension before the dot" },
    { "path": "a/../b.md", "exportable": false, "why": "a dot-dot segment" },
    { "path": "a//b.md", "exportable": false, "why": "an empty segment" },
    { "path": "/abs.md", "exportable": false, "why": "absolute" },
    { "path": "a\\b.md", "exportable": false, "why": "a backslash" },
    { "path": "9:30 standup.md", "exportable": false, "why": "a second-character colon" },
    { "path": "aux.md", "exportable": false, "why": "a Win32 reserved stem" },
    { "path": "Notes/COM1.txt", "exportable": false, "why": "a reserved stem in any segment" },
    { "path": "trailing./x.md", "exportable": false, "why": "a trailing dot in a segment" },
    { "path": "x.md ", "exportable": false, "why": "a trailing space" },
    { "path": "bell\u0007.md", "exportable": false, "why": "a control character" },
    { "path": "c1\u0085.md", "exportable": false, "why": "a C1 control character" }
  ]
}
