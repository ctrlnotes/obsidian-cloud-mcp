{
  "name": "ctrl-notes-cloud-mcp",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "vitest run",
    "build": "node esbuild.config.mjs",
    "build:dev": "node esbuild.config.mjs --dev",
    "install-to-vault": "node tools/install.mjs",
    "format": "biome format .",
    "lint": "biome check . && eslint --max-warnings 0 src package.json manifest.json && eslint --quiet -c eslint.tests.config.mjs src vitest.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "24.19.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "fast-check": "4.10.2",
    "obsidian": "1.13.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  },
  "dependencies": {
    "@noble/ed25519": "3.2.0"
  }
}
