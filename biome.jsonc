// Biome formats and lints everything here except the build output and the fixtures. No
// `linter` block: Biome enables its recommended rules by default.
// `test-fixtures/` is excluded: its JSON is the Ctrl Notes service's wire examples, kept
// byte-for-byte as the service has them, not formatted to this repository's style.
{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": ["**", "!main.js", "!test-fixtures"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  }
}
