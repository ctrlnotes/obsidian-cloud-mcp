{
  "name": "ctrl-notes-cloud-mcp",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node esbuild.config.mjs",
    "build:dev": "node esbuild.config.mjs --dev",
    "install-to-vault": "node tools/install.mjs",
    "format": "biome format .",
    "lint": "biome check . && eslint --max-warnings 0 src package.json manifest.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "^24.10.1",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-plugin-obsidianmd": "0.4.2",
    "fast-check": "^4.9.0",
    "obsidian": "^1.13.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@noble/ed25519": "^3.1.0"
  }
}
